# =============================================================================
# KONFIGURASI AI AGENT RAG - FORMAT STANDAR INDUSTRI
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM CONFIGURATION (Large Language Model)
# -----------------------------------------------------------------------------
# Path ke model GGUF. Jika kosong, sistem akan auto-detect model pertama di folder models/
MODEL_PATH=models/Huihui-Qwen3.5-0.8B-abliterated.Q4_K_M.gguf

# Context window size (jumlah token konteks)
N_CTX=8192

# Jumlah layer yang di-offload ke GPU (-1 = semua, 0 = CPU only)
N_GPU_LAYERS=0

# Jumlah thread CPU untuk inferensi (0 = auto-detect)
N_THREADS=0

# Maksimum token output per respons
MAX_TOKENS=10000

# Temperature untuk sampling (0.0 = deterministik, 1.0 = kreatif)
TEMPERATURE=0.2

# Top-P sampling (nucleus sampling)
TOP_P=0.95

# Top-K sampling
TOP_K=40

# Penalty untuk token repetitif
REPEAT_PENALTY=1.1

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SQLite for Agent Memory)
# -----------------------------------------------------------------------------
# Path ke database SQLite untuk menyimpan memori agent
DB_PATH=database/assistant.db

# Maksimum jumlah riwayat percakapan yang disimpan per sesi
MAX_HISTORY=50

# -----------------------------------------------------------------------------
# 3. FILESYSTEM CONFIGURATION
# -----------------------------------------------------------------------------
# Direktori untuk menyimpan model GGUF
MODELS_DIR=models

# Direktori untuk dokumen yang akan di-index (RAG)
DOCUMENTS_DIR=documents

# Direktori untuk cache temporary
CACHE_DIR=cache

# Direktori untuk log files
LOGS_DIR=logs

# -----------------------------------------------------------------------------
# 4. EMBEDDING MODEL CONFIGURATION (Untuk RAG)
# -----------------------------------------------------------------------------
# Path ke model embedding GGUF (jika menggunakan GGUF embedder)
EMBEDDING_MODEL_PATH=models/nomic-embed-text-v2-moe.Q5_K_M.gguf
OCR_MODEL_PATH=models/PaddleOCR-VL-0.9B.f16.gguf

# Dimension vektor embedding (biasanya 768 atau 1024)
EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# 5. API KEYS (Optional - Untuk layanan eksternal jika diperlukan)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_TOKEN=hf_...

# -----------------------------------------------------------------------------
# 6. SHELL COMMAND SECURITY (Blocklist untuk eksekusi command)
# -----------------------------------------------------------------------------
# Command yang dilarang dieksekusi oleh agent (comma-separated)
SHELL_BLOCKLIST=rm -rf,mkfs,dd,chmod -R 777,chown -R

# Apakah mengizinkan command sudo? (true/false)
ALLOW_SUDO=false

# -----------------------------------------------------------------------------
# 7. AGENT CONFIGURATION
# -----------------------------------------------------------------------------
# Verbosity level untuk logging agent (true/false)
AGENT_VERBOSE=true

# Timeout untuk eksekusi tool dalam detik
TOOL_TIMEOUT=300

# Maksimum iterasi planning sebelum berhenti
MAX_PLANNER_ITERATIONS=10

# -----------------------------------------------------------------------------
# 8. MCP (Model Context Protocol) CONFIGURATION
# -----------------------------------------------------------------------------
# Port untuk MCP API Server
MCP_API_PORT=8080

# Host untuk MCP API Server
MCP_API_HOST=127.0.0.1

# Enable MCP Filesystem Server (true/false)
MCP_ENABLE_FILESYSTEM=true

# Enable MCP SQLite Server (true/false)
MCP_ENABLE_SQLITE=true

# Root directory untuk MCP Filesystem Server
MCP_FS_ROOT=.

# =============================================================================
# END OF CONFIGURATION
# =============================================================================